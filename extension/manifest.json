{
  "manifest_version": 3,
  "name": "网页净化助手 · PagePure",
  "version": "0.6.31",
  "description": "使用 Jev 识别网页模块类别，点击样本选择整类，按网站与页面类型保存净化规则。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "网页净化助手 · PagePure",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/pagepure-16.png",
      "32": "icons/pagepure-32.png",
      "48": "icons/pagepure-48.png",
      "128": "icons/pagepure-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "startup.js",
        "blocks.js",
        "manual.js",
        "layout-snapshot.js",
        "categories.js",
        "content.js",

        "preview.js",
        "console.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "icons/pagepure-48.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/pagepure-16.png",
    "32": "icons/pagepure-32.png",
    "48": "icons/pagepure-48.png",
    "128": "icons/pagepure-128.png"
  }
}
