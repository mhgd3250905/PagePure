{
  "manifest_version": 3,
  "default_locale": "zh_CN",
  "name": "__MSG_extName__",
  "version": "0.7.1",
  "description": "__MSG_extDescription__",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/pagepure-16.png",
      "32": "icons/pagepure-32.png",
      "48": "icons/pagepure-48.png",
      "128": "icons/pagepure-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "i18n.js",
        "startup.js",
        "blocks.js",
        "manual.js",
        "content.js",
        "preview.js",
        "console.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "icons/pagepure-48.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/pagepure-16.png",
    "32": "icons/pagepure-32.png",
    "48": "icons/pagepure-48.png",
    "128": "icons/pagepure-128.png"
  }
}
